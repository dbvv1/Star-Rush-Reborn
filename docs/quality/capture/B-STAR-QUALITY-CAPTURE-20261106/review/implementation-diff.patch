+  const z0=Math.max(0,Math.floor((b.minZ-bounds.z0)/step)),z1=Math.min(nz,Math.floor((b.maxZ-bounds.z0)/step)+1);
+  for(let z=z0;z<=z1;z++)for(let x=x0;x<=x1;x++)locked.add(z*(nx+1)+x);
+ }
